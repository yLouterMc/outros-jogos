local function Desconectar(Connection)
	if Connection then
		pcall(function()
			Connection:Disconnect()
		end)
	end
end

local function CancelarTween(Tween)
	if Tween then
		pcall(function()
			Tween:Cancel()
		end)
	end
end

local function DestruirTween(Tween)
	if Tween then
		pcall(function()
			Tween:Cancel()
			Tween:Destroy()
		end)
	end
	return nil
end

local function LimparTweens()
