end

local function AtualizarAnimacao()
	if Agachado
		and Humanoid
		and Humanoid.Parent
		and Humanoid.Health > 0 then

		PararAnimacaoFerido()

		if Character and Character:GetAttribute("Batendo") then
			if AgachadoIdleTrack and AgachadoIdleTrack.IsPlaying then
				AgachadoIdleTrack:AdjustSpeed(0)
			end

			if AgachadoWalkTrack and AgachadoWalkTrack.IsPlaying then
				AgachadoWalkTrack:AdjustSpeed(0)
			end

			return
		end

		local Movendo = Humanoid.MoveDirection.Magnitude > 0.05

		if Movendo then
			if AgachadoIdleTrack and AgachadoIdleTrack.IsPlaying then
				AgachadoIdleTrack:Stop(0.12)
			end

			if AgachadoWalkTrack and not AgachadoWalkTrack.IsPlaying then
				AgachadoWalkTrack:Play(0.12, 1, 1)
			end

			if AgachadoWalkTrack then
				if Correndo then
					AgachadoWalkTrack:AdjustSpeed(AgachadoCorridaAnimSpeed)
				else
					AgachadoWalkTrack:AdjustSpeed(1)
				end
			end
		else
			if AgachadoWalkTrack and AgachadoWalkTrack.IsPlaying then
				AgachadoWalkTrack:Stop(0.12)
			end

			if AgachadoIdleTrack and not AgachadoIdleTrack.IsPlaying then
				AgachadoIdleTrack:Play(0.12, 1, 1)
			end

			if AgachadoIdleTrack then
				AgachadoIdleTrack:AdjustSpeed(1)
			end
		end

		return
	end

	AtualizarAnimacaoFerido()
end

local function PararAnimacao()
	if AgachadoIdleTrack then
		pcall(function()
			AgachadoIdleTrack:AdjustSpeed(0)
			AgachadoIdleTrack:Stop(0.15)
		end)

		pcall(function()
			AgachadoIdleTrack:Destroy()
		end)

		AgachadoIdleTrack = nil
	end

	if AgachadoWalkTrack then
		pcall(function()
			AgachadoWalkTrack:AdjustSpeed(0)
			AgachadoWalkTrack:Stop(0.15)
		end)

		pcall(function()
			AgachadoWalkTrack:Destroy()
		end)

		AgachadoWalkTrack = nil
	end

	PararAnimacaoFerido()
end

local function Desativar()
	Agachado = false
	Correndo = false
	MobileCorrendo = false

	if Character and Character.Parent then
		Character:SetAttribute("Agachado", false)
	end

	if Humanoid and Humanoid.Parent then
		if Humanoid.Sit then
			Humanoid.AutoRotate = false
		else
			Humanoid.AutoRotate = true
		end

		Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
		Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
	end

	PararAnimacao()
	AtualizarVelocidade()
	AtualizarAnimacaoFerido()
end

local function CriarAnimacao()
	if not Humanoid
		or not Humanoid.Parent
		or Humanoid.Health <= 0 then
		return false
	end

	Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	if AgachadoIdleTrack or AgachadoWalkTrack then
		PararAnimacao()
	end

	local IdleAnimation = Instance.new("Animation")
	IdleAnimation.AnimationId = "rbxassetid://" .. AGACHADO_IDLE_ANIMATION_ID

	local WalkAnimation = Instance.new("Animation")
	WalkAnimation.AnimationId = "rbxassetid://" .. AGACHADO_WALK_ANIMATION_ID

	local SucessoIdle, ResultadoIdle = pcall(function()
		return Animator:LoadAnimation(IdleAnimation)
	end)

	local SucessoWalk, ResultadoWalk = pcall(function()
		return Animator:LoadAnimation(WalkAnimation)
	end)

	IdleAnimation:Destroy()
	WalkAnimation:Destroy()

	if not SucessoIdle
		or not ResultadoIdle
		or not SucessoWalk
		or not ResultadoWalk then

		if ResultadoIdle then
			pcall(function()
				ResultadoIdle:Destroy()
			end)
		end

		if ResultadoWalk then
			pcall(function()
				ResultadoWalk:Destroy()
			end)
		end

		return false
	end

	AgachadoIdleTrack = ResultadoIdle
	AgachadoIdleTrack.Looped = true
	AgachadoIdleTrack.Priority = Enum.AnimationPriority.Action

	AgachadoWalkTrack = ResultadoWalk
	AgachadoWalkTrack.Looped = true
	AgachadoWalkTrack.Priority = Enum.AnimationPriority.Action

	return true
end

local function Ativar()
	if Player:GetAttribute("Vestindo") == true then
		return
	end

	if Agachado then
		Desativar()
		return
	end

	if not Character
		or Character ~= Player.Character
		or not Character.Parent then
		return
	end

	if not Humanoid
		or not Humanoid.Parent
		or Humanoid.Health <= 0 then
		return
	end

	if Humanoid.Sit then
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	Correndo = false
	MobileCorrendo = false
	ShiftPressionado = false

	if not CriarAnimacao() then
		return
	end

	Agachado = true

	Character:SetAttribute("Agachado", true)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)

	Humanoid.WalkSpeed = AgachadoSpeed

	PararAnimacaoFerido()

	if AgachadoIdleTrack then
		AgachadoIdleTrack:Play(0.15, 1, 1)
	end

	task.defer(function()
		if Agachado
			and Character
			and Character.Parent
			and Humanoid
			and Humanoid.Health > 0
			and Player:GetAttribute("Vestindo") ~= true then

			AtualizarAnimacao()
		end
	end)
end

local function EstaTentandoCorrer()
	if Player:GetAttribute("Vestindo") == true then
		return false
	end

	return ShiftPressionado or MobileCorrendo
end

local function AtualizarCorrida(DeltaTime)
	if not Humanoid
		or not Humanoid.Parent
		or not Character
		or not Character.Parent
		or Humanoid.Health <= 0 then
		return
	end

	if Player:GetAttribute("Vestindo") == true then
		Correndo = false
		MobileCorrendo = false

		Stamina += StaminaRecuperacao * DeltaTime
		Stamina = math.clamp(Stamina, 0, MaxStamina)

		AtualizarVelocidade()
		AtualizarStaminaUI(false)

		return
	end

	if Humanoid.Sit or Character:GetAttribute("Batendo") then
		Correndo = false

		AtualizarVelocidade()

		Stamina += StaminaRecuperacao * DeltaTime
		Stamina = math.clamp(Stamina, 0, MaxStamina)

		AtualizarStaminaUI(false)

		return
	end

	local Movendo = Humanoid.MoveDirection.Magnitude > 0.05
	local TentandoCorrer = EstaTentandoCorrer()

	if TentandoCorrer and Movendo and Stamina > 0 then
		Correndo = true

		Stamina -= StaminaGasto * DeltaTime
		Stamina = math.clamp(Stamina, 0, MaxStamina)

		if Stamina <= 0 then
			Correndo = false
		end
	else
		Correndo = false

		if not Movendo or not TentandoCorrer then
			Stamina += StaminaRecuperacao * DeltaTime
			Stamina = math.clamp(Stamina, 0, MaxStamina)
		end
	end

	AtualizarVelocidade()
	AtualizarAnimacao()
	AtualizarStaminaUI(false)
end

local function SempreOn(Gui)
	if not Gui then
		return
	end

	local JumpButton = Gui:FindFirstChild("JumpButton", true)

	local function Atualizar()
		if Gui.Parent then
			Gui.Enabled = true
		end

		if JumpButton and JumpButton.Parent then
			JumpButton.Visible = true
		end
	end

	Atualizar()

	Gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if Gui.Parent and not Gui.Enabled then
			Gui.Enabled = true
		end
	end)

	if JumpButton then
		JumpButton:GetPropertyChangedSignal("Visible"):Connect(function()
			if JumpButton.Parent and not JumpButton.Visible then
				JumpButton.Visible = true
			end
		end)
	end
end

local function ConfigurarMobile()
	if MobileConfigurado then
		return
	end

	local PlayerGui = Player:WaitForChild("PlayerGui", 10)

	if not PlayerGui then
		return
	end

	local Screen = PlayerGui:FindFirstChild("ScreenGui")

	if not Screen then
		Screen = PlayerGui:WaitForChild("ScreenGui", 5)
	end

	local TemTouch = PlayerGui:FindFirstChild("TouchGui")

	if not TemTouch then
		TemTouch = PlayerGui:WaitForChild("TouchGui", 3)
	end

	if not TemTouch then
		return
	end

	MobileConfigurado = true

	SempreOn(TemTouch)

	if Screen then
		local TextLabel = Screen:FindFirstChild("TextLabel")

		if TextLabel then
			TextLabel.Visible = false
		end
	end

	Module:UnbindAction("Correr")
	Module:UnbindAction("Agachar")

	Module:BindAction("Correr", function(_, InputState)
		if Player:GetAttribute("Vestindo") == true then
			MobileCorrendo = false
			return
		end

		if InputState == Enum.UserInputState.Begin then
			MobileCorrendo = true
		elseif InputState == Enum.UserInputState.End
			or InputState == Enum.UserInputState.Cancel then

			MobileCorrendo = false
		end
	end, true, Enum.KeyCode.LeftShift)

	Module:SetTitle("Correr", "Correr")

	Module:BindAction("Agachar", function(_, InputState)
		if Player:GetAttribute("Vestindo") == true then
			return
		end

		if InputState == Enum.UserInputState.Begin then
			Ativar()
		end
	end, true, Enum.KeyCode.LeftControl)

	Module:SetTitle("Agachar", "Agachar")
end

local function ConfigurarCamera()
	if not Humanoid or not Humanoid.Parent then
		return
	end

	Camera = workspace.CurrentCamera or Camera

	if not Camera then
		return
	end

	Camera.CameraType = Enum.CameraType.Custom
	Camera.CameraSubject = Humanoid

	Player.CameraMode = Enum.CameraMode.Classic
	Player.CameraMinZoomDistance = 6.5
	Player.CameraMaxZoomDistance = 8.5

	Humanoid.CameraOffset = Vector3.new(1.25, 0.8, 0)

	CriarBlur()
	AtualizarBlurFerimento(true)
	AtualizarTonturaAlvo()
	AtualizarMouse()
end

local function DesconectarCharacter()
	Desconectar(DeathConnection)
	Desconectar(MoveConnection)
	Desconectar(BatendoConnection)
	Desconectar(StateConnection)
	Desconectar(SitConnection)
	Desconectar(HealthConnection)
	Desconectar(MaxHealthConnection)

	DeathConnection = nil
	MoveConnection = nil
	BatendoConnection = nil
	StateConnection = nil
	SitConnection = nil
	HealthConnection = nil
	MaxHealthConnection = nil
end

local function PrepararCharacter(NovoCharacter)
	CharacterGeneration += 1

	local MinhaGeneration = CharacterGeneration

	DesconectarCharacter()

	Agachado = false
	Correndo = false
	ShiftPressionado = false
	MobileCorrendo = false
	Ferido = false
	RotacaoSentado = nil
	EstavaSentado = false
	CameraTonturaAtual = 0
	CameraTonturaAlvo = 0
	CameraTonturaTempo = 0

	PararAnimacao()
	EsconderHUD()
	RemoverBlur()

	Character = NovoCharacter
	Humanoid = nil
	Animator = nil
	Root = nil

	if not Character or not Character.Parent then
		return
	end

	Humanoid = Character:WaitForChild("Humanoid", 10)
	Root = Character:WaitForChild("HumanoidRootPart", 10)

	if MinhaGeneration ~= CharacterGeneration then
		return
	end

	if not Humanoid or not Root then
		return
	end

	Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then
		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid
	end

	Character:SetAttribute("Agachado", false)

	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
	Humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)

	Humanoid.AutoRotate = true
	Humanoid.WalkSpeed = NormalSpeed

	Stamina = MaxStamina

	UltimaVida = 1
	UltimaStamina = 1
	VidaBaixa = false
	StaminaBaixa = false
	Ferido = false
	
	task.delay(5, function()
		if not HUD or not HUD.Parent then
			CriarHUD()
		end

		MostrarHUD()
		AtualizarVidaUI()
		AtualizarStaminaUI(true)
	end)

	ConfigurarCamera()
	CriarBlur()
	AtualizarBlurFerimento(true)
	AtualizarTonturaAlvo()

	SitConnection = Humanoid:GetPropertyChangedSignal("Sit"):Connect(function()
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		if not Humanoid
			or not Humanoid.Parent
			or not Root
			or Humanoid.Health <= 0 then
			return
		end

		if Humanoid.Sit then
			EstavaSentado = true
			Humanoid.AutoRotate = false

			local _, Y, _ = Root.CFrame:ToOrientation()
			RotacaoSentado = Y

			Correndo = false
			MobileCorrendo = false

			AtualizarVelocidade()
			AtualizarAnimacaoFerido()
		else
			EstavaSentado = false
			RotacaoSentado = nil
			Humanoid.AutoRotate = true

			AtualizarVelocidade()
			AtualizarAnimacaoFerido()
		end
	end)

	StateConnection = Humanoid.StateChanged:Connect(function(_, NovoEstado)
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		if not Humanoid
			or not Humanoid.Parent
			or Humanoid.Health <= 0 then
			return
		end

		if NovoEstado == Enum.HumanoidStateType.Seated then
			Humanoid.AutoRotate = false

			if Root and Root.Parent then
				local _, Y, _ = Root.CFrame:ToOrientation()
				RotacaoSentado = Y
			end

			EstavaSentado = true
			Correndo = false
			MobileCorrendo = false

			AtualizarVelocidade()
			AtualizarAnimacaoFerido()

			return
		end

		if EstavaSentado and NovoEstado ~= Enum.HumanoidStateType.Seated then
			EstavaSentado = false
			RotacaoSentado = nil
			Humanoid.AutoRotate = true

			AtualizarVelocidade()
			AtualizarAnimacaoFerido()
		end

		if not Agachado then
			return
		end

		if NovoEstado == Enum.HumanoidStateType.Jumping
			or NovoEstado == Enum.HumanoidStateType.Freefall
			or NovoEstado == Enum.HumanoidStateType.FallingDown then

			Humanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
	end)

	MoveConnection = Humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		AtualizarAnimacao()
		AtualizarAnimacaoFerido()
	end)

	HealthConnection = Humanoid.HealthChanged:Connect(function()
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		if Humanoid and Humanoid.Parent then
			AtualizarVidaUI()
			AtualizarFerimento()
		end
	end)

	MaxHealthConnection = Humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		if Humanoid and Humanoid.Parent then
			AtualizarVidaUI()
			AtualizarFerimento()
		end
	end)

	BatendoConnection = Character:GetAttributeChangedSignal("Batendo"):Connect(function()
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		AtualizarAnimacao()
		AtualizarAnimacaoFerido()
		AtualizarVelocidade()
	end)

	DeathConnection = Humanoid.Died:Connect(function()
		if MinhaGeneration ~= CharacterGeneration then
			return
		end

		Agachado = false
		Correndo = false
		MobileCorrendo = false
		Ferido = false
		RotacaoSentado = nil
		EstavaSentado = false
		CameraTonturaAlvo = 0
		CameraTonturaAtual = 0

		if Character and Character.Parent then
			Character:SetAttribute("Agachado", false)
		end

		PararAnimacao()
		EsconderHUD()
		LimparTweens()
		RemoverBlur()
	end)

	AtualizarFerimento()
	AtualizarVelocidade()
	AtualizarBlurFerimento(true)
	AtualizarTonturaAlvo()
	AtualizarMouse()
end

UserInputService.InputBegan:Connect(function(Input, GameProcessed)
	if GameProcessed then
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if Input.KeyCode == Enum.KeyCode.LeftShift
		or Input.KeyCode == Enum.KeyCode.RightShift then

		if Player:GetAttribute("Vestindo") == true then
			return
		end

		ShiftPressionado = true

	elseif Input.KeyCode == Enum.KeyCode.LeftControl then
		if Player:GetAttribute("Vestindo") == true then
			return
		end

		Ativar()

	elseif Input.KeyCode == Enum.KeyCode.DPadDown then
		if Player:GetAttribute("Vestindo") == true then
			return
		end

		Ativar()
	end
end)

UserInputService.InputEnded:Connect(function(Input)
	if Input.KeyCode == Enum.KeyCode.LeftShift
		or Input.KeyCode == Enum.KeyCode.RightShift then

		ShiftPressionado = false
	end
end)

VestindoConnection = Player:GetAttributeChangedSignal("Vestindo"):Connect(function()
	local Vestindo = Player:GetAttribute("Vestindo")

	if Vestindo == true then
		ShiftPressionado = false
		MobileCorrendo = false
		Correndo = false

		if Agachado then
			Desativar()
		else
			PararAnimacao()
			AtualizarVelocidade()
			AtualizarAnimacaoFerido()
		end
	else
		AtualizarVelocidade()
		AtualizarAnimacaoFerido()
	end

	AtualizarMouse()
end)

CriarHUD()

if Player.Character then
	task.defer(function()
		PrepararCharacter(Player.Character)
	end)
end

Player.CharacterAdded:Connect(function(NovoCharacter)
	PrepararCharacter(NovoCharacter)
end)

task.defer(function()
	ConfigurarMobile()
end)

RunService:BindToRenderStep(
	"AtualizarGameplay",
	Enum.RenderPriority.Character.Value + 1,
	function(DeltaTime)
		AtualizarCorrida(DeltaTime)

		AtualizarMouse()

		if Character
			and Character.Parent
			and Humanoid
			and Humanoid.Parent
			and Humanoid.Health > 0 then

			AtualizarAnimacao()
		end

		if not Character
			or not Character.Parent
			or not Humanoid
			or not Humanoid.Parent
			or Humanoid.Health <= 0
			or not Root
			or not Root.Parent then

			return
		end

		if Humanoid.Sit then
			Humanoid.AutoRotate = false

			if RotacaoSentado then
				Root.CFrame =
					CFrame.new(Root.Position)
					* CFrame.Angles(0, RotacaoSentado, 0)
			end

			return
		end

		if Agachado then
			return
		end

		Humanoid.AutoRotate = true

		local MoveDirection = Humanoid.MoveDirection

		if MoveDirection.Magnitude > 0.05 then
			local TargetCFrame = CFrame.lookAt(
				Root.Position,
				Root.Position + MoveDirection
			)

			local RotationSpeed = Correndo and 7 or 5
			local Alpha = 1 - math.exp(-RotationSpeed * DeltaTime)

			Root.CFrame = Root.CFrame:Lerp(
				TargetCFrame,
				Alpha
			)
		end
	end
)

RunService:BindToRenderStep(
	"EfeitoFerimentoCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function(DeltaTime)
		AtualizarCameraTontura(DeltaTime)
	end
)

