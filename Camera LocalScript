		VidaImpactTween = DestruirTween(VidaImpactTween)

		VidaImpactTween = TweenService:Create(
			BarraScale,
			TweenInfo.new(0.1, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{Scale = 1.035}
		)

		VidaImpactTween:Play()

		task.delay(0.1, function()
			if Generation ~= HUDGeneration then
				return
			end

			if not BarraScale or not BarraScale.Parent then
				return
			end

			VidaImpactTween = DestruirTween(VidaImpactTween)

			VidaImpactTween = TweenService:Create(
				BarraScale,
				TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{Scale = 1}
			)

