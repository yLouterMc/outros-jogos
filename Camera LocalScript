		or Humanoid.Health < 0
		or not VidaBar
		or not VidaTexto
		or not VidaGlow
		or not VidaBar.Parent then
		return
	end

	local MaxHealth = Humanoid.MaxHealth

	if MaxHealth <= 0 then
		return
	end

	local Porcentagem = math.clamp(Humanoid.Health / MaxHealth, 0, 1)
	local Percentual = math.floor(Porcentagem * 100 + 0.5)

	VidaTexto.Text = Percentual .. "%"

	local Linha = VidaBar.Parent.Parent
	local Icone = Linha and Linha:FindFirstChild("Icone")

	if Porcentagem <= 0.2 then
		VidaTexto.TextColor3 = Color3.fromRGB(255, 95, 95)

		if Icone then
			Icone.TextColor3 = Color3.fromRGB(255, 70, 70)
		end
	elseif Porcentagem <= 0.5 then
		VidaTexto.TextColor3 = Color3.fromRGB(255, 185, 80)

		if Icone then
			Icone.TextColor3 = Color3.fromRGB(255, 130, 65)
		end
	else
		VidaTexto.TextColor3 = Color3.fromRGB(255, 255, 255)

		if Icone then
			Icone.TextColor3 = Color3.fromRGB(255, 70, 82)
		end
	end

	VidaTween = DestruirTween(VidaTween)
	VidaGlowTween = DestruirTween(VidaGlowTween)

	VidaBar.Size = UDim2.new(Porcentagem, 0, 1, 0)

	VidaGlowTween = TweenService:Create(
		VidaGlow,
		TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Position = UDim2.new(Porcentagem, -2, 0.5, 0)}
	)

	VidaGlowTween:Play()

	if math.abs(Porcentagem - UltimaVida) > 0.05 then
		AnimacaoImpacto(VidaScale, "Vida")
	end

	local AgoraBaixa = Porcentagem <= 0.2

	if AgoraBaixa and not VidaBaixa and Icone then
		AnimacaoIcone(Icone, Icone.TextSize, "Vida")
	end

	VidaBaixa = AgoraBaixa
	UltimaVida = Porcentagem
end

local function AtualizarVelocidade()
	if not Character
		or not Character.Parent
		or not Humanoid
		or Humanoid.Health <= 0 then
		return
	end

	if Character:GetAttribute("Batendo") or Humanoid.Sit then
		Correndo = false
		Humanoid.WalkSpeed = AgachadoSpeed
		return
	end

	if Player:GetAttribute("Vestindo") == true then
		Correndo = false
		Humanoid.WalkSpeed = NormalSpeed
		return
	end

	if Agachado then
		if Correndo then
			Humanoid.WalkSpeed = AgachadoCorridaSpeed
		else
			Humanoid.WalkSpeed = AgachadoSpeed
		end
		return
	end

	if Ferido then
		if Correndo then
			Humanoid.WalkSpeed = FeridoCorridaSpeed
		else
			Humanoid.WalkSpeed = FeridoSpeed
		end

		return
	end

	if Correndo then
		Humanoid.WalkSpeed = CorridaSpeed
	else
		Humanoid.WalkSpeed = NormalSpeed
	end
end

local function PararAnimacaoFerido()
	if FeridoIdleTrack then
		pcall(function()
			FeridoIdleTrack:AdjustWeight(0, 0.1)
			FeridoIdleTrack:Stop(0.1)
		end)

		pcall(function()
			FeridoIdleTrack:Destroy()
		end)

		FeridoIdleTrack = nil
	end
end

local function CriarAnimacaoFerido()
	if not Animator
		or not Animator.Parent
		or not Humanoid
		or not Humanoid.Parent
		or Humanoid.Health <= 0 then
		return false
	end

	if FeridoIdleTrack and FeridoIdleTrack.Parent then
		return true
	end

	PararAnimacaoFerido()

	local Animation = Instance.new("Animation")
	Animation.AnimationId = "rbxassetid://" .. FERIDO_IDLE_ANIMATION_ID

	local Sucesso, Resultado = pcall(function()
		return Animator:LoadAnimation(Animation)
	end)

	Animation:Destroy()

	if not Sucesso or not Resultado then
		return false
	end

	FeridoIdleTrack = Resultado
	FeridoIdleTrack.Looped = true
	FeridoIdleTrack.Priority = Enum.AnimationPriority.Movement

	return true
end

local function AtualizarAnimacaoFerido()
	if Agachado then
		PararAnimacaoFerido()
		return
	end

	if not Ferido
		or not Humanoid
		or not Humanoid.Parent
		or Humanoid.Health <= 0 then

		PararAnimacaoFerido()
		return
	end

	if Humanoid.Sit then
		PararAnimacaoFerido()
		return
	end

	if Character and Character:GetAttribute("Batendo") then
		PararAnimacaoFerido()
		return
	end

	local Movendo = Humanoid.MoveDirection.Magnitude > 0.05

	if Movendo then
		if FeridoIdleTrack and FeridoIdleTrack.IsPlaying then
			FeridoIdleTrack:Stop(0.12)
		end

		return
	end

	if not FeridoIdleTrack or not FeridoIdleTrack.Parent then
		if not CriarAnimacaoFerido() then
			return
		end
	end

	if not FeridoIdleTrack then
		return
	end

	if not FeridoIdleTrack.IsPlaying then
		FeridoIdleTrack:Play(0.2, 1, 1)
	else
		FeridoIdleTrack:AdjustSpeed(1)
	end
end

local function AtualizarFerimento()
	if not Humanoid or not Humanoid.Parent or Humanoid.MaxHealth <= 0 then
		return
	end

	local Porcentagem = math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1)
	local FeridoAnterior = Ferido

	if not Ferido and Porcentagem <= FeridoAtivaPorcentagem then
		Ferido = true
	elseif Ferido and Porcentagem >= FeridoRecuperaPorcentagem then
		Ferido = false
	end

	AtualizarVelocidade()
	AtualizarBlurFerimento(false)
	AtualizarTonturaAlvo()

	if Ferido ~= FeridoAnterior then
		if Ferido then
			AtualizarAnimacaoFerido()
		else
			PararAnimacaoFerido()
		end
	else
		AtualizarAnimacaoFerido()
	end
end

local function AtualizarStaminaUI(Instantaneo)
	if not StaminaBar
		or not StaminaTexto
		or not StaminaGlow
		or not StaminaBar.Parent then
		return
	end

	local Porcentagem = math.clamp(Stamina / MaxStamina, 0, 1)
	local Percentual = math.floor(Porcentagem * 100 + 0.5)

	StaminaTexto.Text = Percentual .. "%"

	local Linha = StaminaBar.Parent.Parent
	local Icone = Linha and Linha:FindFirstChild("Icone")
	local Gradient = StaminaBar:FindFirstChildOfClass("UIGradient")

	if Porcentagem <= 0.2 then
		StaminaTexto.TextColor3 = Color3.fromRGB(255, 100, 100)

		if Icone then
			Icone.TextColor3 = Color3.fromRGB(255, 90, 70)
		end

		if Gradient then
			Gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 105, 85)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 70, 70)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(205, 45, 45))
			})
		end
	else
		StaminaTexto.TextColor3 = Color3.fromRGB(255, 255, 255)

		if Icone then
			Icone.TextColor3 = Color3.fromRGB(255, 204, 55)
		end

		if Gradient then
			Gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 225, 77)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 198, 45)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 165, 35))
			})
		end
	end

	if Instantaneo then
		StaminaTween = DestruirTween(StaminaTween)
		StaminaBar.Size = UDim2.new(Porcentagem, 0, 1, 0)
	else
		StaminaTween = DestruirTween(StaminaTween)

		StaminaTween = TweenService:Create(
			StaminaBar,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Size = UDim2.new(Porcentagem, 0, 1, 0)}
		)

		StaminaTween:Play()
	end

	StaminaGlowTween = DestruirTween(StaminaGlowTween)

	StaminaGlowTween = TweenService:Create(
		StaminaGlow,
		TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Position = UDim2.new(Porcentagem, -2, 0.5, 0)}
	)

	StaminaGlowTween:Play()

	if math.abs(Porcentagem - UltimaStamina) > 0.08 then
		AnimacaoImpacto(StaminaScale, "Stamina")
	end

	local AgoraBaixa = Porcentagem <= 0.2

	if AgoraBaixa and not StaminaBaixa and Icone then
		AnimacaoIcone(Icone, Icone.TextSize, "Stamina")
	end

	StaminaBaixa = AgoraBaixa
	UltimaStamina = Porcentagem
end

local function MostrarHUD()
	if not HUD or not HUD.Parent then
		if not CriarHUD() then
			return
		end
	end

	if not HUD then
		return
	end

	HUD.Enabled = true

	if Container and Container.Parent then
		local Scale = Container:FindFirstChildOfClass("UIScale")

		if Scale then
			HUDScaleTween = DestruirTween(HUDScaleTween)

			Scale.Scale = 0.82

			HUDScaleTween = TweenService:Create(
				Scale,
				TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{Scale = 1}
			)

			HUDScaleTween:Play()
		end

		HUDBackgroundTween = DestruirTween(HUDBackgroundTween)
	end
end

local function EsconderHUD()
	if HUD then
		HUD.Enabled = false
	end
end

