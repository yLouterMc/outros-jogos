local function CriarBlur()
	Camera = workspace.CurrentCamera or Camera

	if not Camera then
		return
	end

	if BlurEffect and BlurEffect.Parent == Camera then
		return
	end

	if BlurEffect then
		pcall(function()
			BlurEffect:Destroy()
		end)
	end

	BlurEffect = Instance.new("BlurEffect")
	BlurEffect.Name = "FerimentoBlur"
	BlurEffect.Size = 0
	BlurEffect.Parent = Camera
end

local function AtualizarBlurFerimento(Instantaneo)
	if not Humanoid
		or not Humanoid.Parent
		or Humanoid.MaxHealth <= 0 then
		return
	end

	Camera = workspace.CurrentCamera or Camera

	if not Camera then
		return
	end

	if not BlurEffect or not BlurEffect.Parent or BlurEffect.Parent ~= Camera then
		CriarBlur()
	end

	if not BlurEffect then
		return
	end

	local Porcentagem = math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1)
	local BlurSize = 0

	if Porcentagem < 0.7 then
		if Porcentagem >= 0.5 then
			local Alpha = (0.7 - Porcentagem) / 0.2
			BlurSize = 3 * Alpha
		elseif Porcentagem >= 0.3 then
			local Alpha = (0.5 - Porcentagem) / 0.2
			BlurSize = 3 + 5 * Alpha
		else
			local Alpha = math.clamp((0.3 - Porcentagem) / 0.3, 0, 1)
			BlurSize = 8 + 4 * Alpha
		end
	end

	BlurSize = math.clamp(BlurSize, 0, 12)

	BlurTween = DestruirTween(BlurTween)

	if Instantaneo then
		BlurEffect.Size = BlurSize
		return
	end

	BlurTween = TweenService:Create(
		BlurEffect,
		TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{Size = BlurSize}
	)

	BlurTween:Play()
end

local function RemoverBlur()
	BlurTween = DestruirTween(BlurTween)

	if BlurEffect then
		pcall(function()
			BlurEffect.Size = 0
			BlurEffect:Destroy()
		end)
	end

	BlurEffect = nil
end

local function AtualizarTonturaAlvo()
	if not Humanoid or not Humanoid.Parent or Humanoid.MaxHealth <= 0 then
		CameraTonturaAlvo = 0
		return
	end

	local Porcentagem = math.clamp(Humanoid.Health / Humanoid.MaxHealth, 0, 1)

	if Porcentagem >= 0.7 then
		CameraTonturaAlvo = 0
		return
	end

	local Alpha = math.clamp((0.7 - Porcentagem) / 0.7, 0, 1)

	CameraTonturaAlvo = Alpha * Alpha
end

local function AtualizarCameraTontura(DeltaTime)
	Camera = workspace.CurrentCamera or Camera

	if not Camera
		or not Humanoid
		or not Humanoid.Parent
		or Humanoid.Health <= 0 then

		CameraTonturaAlvo = 0
		CameraTonturaAtual += (0 - CameraTonturaAtual) * math.clamp(DeltaTime * 8, 0, 1)
		return
	end

	AtualizarTonturaAlvo()

	CameraTonturaAtual += (CameraTonturaAlvo - CameraTonturaAtual) * math.clamp(DeltaTime * 5, 0, 1)
	CameraTonturaTempo += DeltaTime

	if CameraTonturaAtual <= 0.001 then
		return
	end

	local Intensidade = CameraTonturaAtual

	local FrequenciaX = 2.4 + Intensidade * 2.2
	local FrequenciaY = 3.1 + Intensidade * 2.8
	local FrequenciaRoll = 1.8 + Intensidade * 2

	local MovimentoX = math.sin(CameraTonturaTempo * FrequenciaX) * 0.035 * Intensidade
	local MovimentoY = math.sin(CameraTonturaTempo * FrequenciaY + 1.7) * 0.025 * Intensidade
	local Roll = math.sin(CameraTonturaTempo * FrequenciaRoll + 0.8) * math.rad(2.2) * Intensidade

	Camera.CFrame =
		Camera.CFrame
		* CFrame.new(MovimentoX, MovimentoY, 0)
		* CFrame.Angles(0, 0, Roll)
end

